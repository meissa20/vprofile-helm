{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["database", "cache", "rabbitmq", "application", "ingress"],
  "properties": {
    "nameOverride": { "type": "string" },
    "database": { "$ref": "#/definitions/database" },
    "cache": { "$ref": "#/definitions/component" },
    "rabbitmq": { "$ref": "#/definitions/rabbitmq" },
    "application": { "$ref": "#/definitions/component" },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string" }
                  },
                  "required": ["path", "pathType"]
                }
              }
            },
            "required": ["paths"]
          }
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object", "additionalProperties": { "type": "string" } },
        "limits": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer" }
      }
    },
    "component": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "service": { "$ref": "#/definitions/service" },
        "resources": { "$ref": "#/definitions/resources" },
        "initImage": { "type": "string" }
      }
    },
    "rabbitmq": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "image": { "$ref": "#/definitions/image" },
        "service": { "$ref": "#/definitions/service" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "initImage": { "type": "string" },
        "password": { "type": "string" },
        "service": { "$ref": "#/definitions/service" },
        "persistence": {
          "type": "object",
          "properties": {
            "accessMode": { "type": "string" },
            "size": { "type": "string" },
            "storageClassName": { "type": "string" }
          }
        },
        "storageClass": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "provisioner": { "type": "string" },
            "type": { "type": "string" },
            "encrypted": { "type": "boolean" },
            "reclaimPolicy": { "type": "string" },
            "volumeBindingMode": { "type": "string" },
            "allowVolumeExpansion": { "type": "boolean" },
            "default": { "type": "boolean" }
          }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "initResources": { "$ref": "#/definitions/resources" }
      }
    }
  }
}
